<?xml version="1.0" encoding="utf-8"?>
<!--
  Release/default policy: HTTPS only, system trust store.
  The debug variant overrides this file (see src/debug/res/xml/network_security_config.xml)
  to permit cleartext HTTP so the app can reach the local FuelGo backend over
  http://<PC-LAN-IP>:5086 during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
